# Copy this file to .env.mobile and use the phone's Wireless debugging
# "IP address & port" value. Do not use the temporary pairing port.
ANDROID_UDID=192.168.1.50:40567

# Keep mobile automation separate from the development site by targeting the
# deployed test subject unless you intentionally choose another reachable URL.
MOBILE_BASE_URL=https://frss-food-rescue-and-sharing-system.netlify.app/

# Optional dedicated regular test account for acceptance cases.
FRSS_EMAIL=
FRSS_PASSWORD=
# Use an address that has never been registered with this FRSS project.
FRSS_UNKNOWN_EMAIL=
